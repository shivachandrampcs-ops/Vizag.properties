# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres_app:CHANGE_ME@127.0.0.1:5432/app_db

# ─────────────────────────────────────────────────────────────
# Auth - use a long random string (e.g. openssl rand -base64 64)
# ─────────────────────────────────────────────────────────────
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ─────────────────────────────────────────────────────────────
# Site URL (used for canonical URLs, sitemap and OG tags)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://vizag.properties

# ─────────────────────────────────────────────────────────────
# Image uploads (Cloudinary - SERVER SIDE ONLY, never expose to the browser)
#
# 1. Create a free Cloudinary account: https://cloudinary.com
# 2. Dashboard → Product Environment Credentials → copy:
#      Cloud Name, API Key, API Secret
# 3. Paste them below. The API secret is only ever used on the server
#    (it signs the upload request); it is never sent to the browser.
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Folder inside Cloudinary where property photos are stored
CLOUDINARY_UPLOAD_FOLDER=vizag-properties

# Storage provider: "cloudinary" (default / production) or "local".
# "local" writes to public/uploads and is FOR DEVELOPMENT ONLY - it is
# automatically refused when NODE_ENV=production.
UPLOAD_PROVIDER=cloudinary
# Required (together with UPLOAD_PROVIDER=local) to enable the dev provider.
ALLOW_LOCAL_UPLOADS=false
